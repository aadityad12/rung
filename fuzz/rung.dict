# libFuzzer dictionary for Rung (docs/notes.md D9). Tokens the mutator splices into inputs so
# it reaches deep parser states without having to guess "while" one byte at a time.

# Keywords
"and"
"else"
"false"
"fn"
"for"
"if"
"let"
"nil"
"or"
"print"
"return"
"true"
"while"

# Native functions (ordinary identifiers, but worth having)
"array"
"len"
"clock"

# Operators and punctuation
"+"
"-"
"*"
"/"
"%"
"!"
"!="
"="
"=="
"<"
"<="
">"
">="
"("
")"
"{"
"}"
"["
"]"
","
";"

# Literals and lexical edge cases
"2147483648"
"-2147483648"
"2147483647"
"0.25"
"1.5"
"\"\\n\""
"\"\\t\""
"\"\\\"\""
"\"\\\\\""
"\"\\q\""
"//"
"\x0a"
"\x22"

# Shapes that hit resolver and parser rules
"let a = a;"
"return 1;"
"fn f(a, a) {}"
"{ let a = 1; let a = 2; }"
"fn f() { fn g() { return f; } }"
"for (let i = 0; i < 3; i = i + 1) {}"
"if (true) {} else {}"
"x[0] = 1;"
"1 = 2;"
