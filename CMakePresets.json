{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RUNG_VM_COUNTERS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (benchmarks)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RUNG_SANITIZE": "address,undefined",
        "RUNG_VM_COUNTERS": "ON"
      }
    },
    {
      "name": "release-goto",
      "displayName": "Release with computed-goto dispatch (ladder rung 3a)",
      "inherits": "release",
      "cacheVariables": { "RUNG_COMPUTED_GOTO": "ON" }
    },
    {
      "name": "asan-goto",
      "displayName": "ASan + UBSan with computed-goto dispatch",
      "inherits": "asan",
      "cacheVariables": { "RUNG_COMPUTED_GOTO": "ON" }
    },
    {
      "name": "release-goto-nanbox",
      "displayName": "Release with computed goto and NaN-boxed values (ladder rung 3b)",
      "inherits": "release-goto",
      "cacheVariables": { "RUNG_NANBOX": "ON" }
    },
    {
      "name": "asan-goto-nanbox",
      "displayName": "ASan + UBSan with computed goto and NaN-boxed values",
      "inherits": "asan-goto",
      "cacheVariables": { "RUNG_NANBOX": "ON" }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer front-end target (needs clang with libFuzzer, not Apple clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RUNG_FUZZ": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RUNG_SANITIZE": "thread",
        "RUNG_VM_COUNTERS": "ON"
      }
    },
    {
      "name": "tsan-goto-nanbox",
      "displayName": "ThreadSanitizer with computed goto and NaN-boxed values (has the JIT on arm64)",
      "inherits": "tsan",
      "cacheVariables": { "RUNG_COMPUTED_GOTO": "ON", "RUNG_NANBOX": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release-goto", "configurePreset": "release-goto" },
    { "name": "asan-goto", "configurePreset": "asan-goto" },
    { "name": "release-goto-nanbox", "configurePreset": "release-goto-nanbox" },
    { "name": "asan-goto-nanbox", "configurePreset": "asan-goto-nanbox" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "tsan-goto-nanbox", "configurePreset": "tsan-goto-nanbox" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    { "name": "release-goto", "inherits": "base", "configurePreset": "release-goto" },
    {
      "name": "asan-goto",
      "inherits": "base",
      "configurePreset": "asan-goto",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    {
      "name": "release-goto-nanbox",
      "inherits": "base",
      "configurePreset": "release-goto-nanbox"
    },
    {
      "name": "asan-goto-nanbox",
      "inherits": "base",
      "configurePreset": "asan-goto-nanbox",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" },
    {
      "name": "tsan-goto-nanbox",
      "inherits": "base",
      "configurePreset": "tsan-goto-nanbox"
    },
    { "name": "fuzz", "inherits": "base", "configurePreset": "fuzz" }
  ]
}
